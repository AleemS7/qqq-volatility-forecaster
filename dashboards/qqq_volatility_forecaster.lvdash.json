{
  "datasets": [
    {
      "name": "latest",
      "displayName": "latest",
      "queryLines": [
        "SELECT date, forecast, vxn, premium, rv_21, status FROM gold.daily_metrics ORDER BY date DESC LIMIT 1"
      ]
    },
    {
      "name": "forecast",
      "displayName": "forecast",
      "queryLines": [
        "SELECT CAST(p.date AS DATE) AS date, p.forecast, p.actual, p.vxn FROM gold.backtest_predictions p JOIN (SELECT champion FROM gold.backtest_runs ORDER BY run_at DESC LIMIT 1) c ON p.model = c.champion"
      ]
    },
    {
      "name": "vrp",
      "displayName": "vrp",
      "queryLines": [
        "SELECT CAST(date AS DATE) AS date, implied, realized, premium, scoreboard FROM gold.vrp_windows"
      ]
    },
    {
      "name": "vrp_stats",
      "displayName": "vrp stats",
      "queryLines": [
        "SELECT ROUND(100 * AVG(CASE WHEN premium > 0 THEN 1 ELSE 0 END), 1) AS share_overpriced_pct, ROUND(MEDIAN(premium), 2) AS median_premium, ROUND(MIN(premium), 2) AS worst_premium FROM gold.vrp_windows"
      ]
    },
    {
      "name": "scores_overall",
      "displayName": "scores overall",
      "queryLines": [
        "SELECT model, ROUND(mae, 3) AS mae FROM gold.model_scores WHERE year = 'overall'"
      ]
    },
    {
      "name": "scores_yearly",
      "displayName": "scores yearly",
      "queryLines": [
        "SELECT model, CAST(year AS INT) AS year, ROUND(mae, 3) AS mae FROM gold.model_scores WHERE year <> 'overall'"
      ]
    },
    {
      "name": "beats",
      "displayName": "beats",
      "queryLines": [
        "SELECT s.model, SUM(CASE WHEN s.mae < b.mae THEN 1 ELSE 0 END) AS years_beat_baseline FROM gold.model_scores s JOIN gold.model_scores b ON s.year = b.year AND b.model = 'M0' WHERE s.year <> 'overall' AND s.model <> 'M0' GROUP BY s.model"
      ]
    },
    {
      "name": "runs",
      "displayName": "runs",
      "queryLines": [
        "SELECT TO_DATE(SUBSTR(started_at, 1, 10)) AS day, status, COUNT(*) AS steps FROM ops.run_log GROUP BY ALL"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "quarantine",
      "queryLines": [
        "SELECT rule_id, action, COUNT(*) AS rows FROM ops.quarantine GROUP BY ALL"
      ]
    },
    {
      "name": "rows_quarantined",
      "displayName": "rows quarantined",
      "queryLines": [
        "SELECT TO_DATE(SUBSTR(started_at, 1, 10)) AS day, SUM(rows_quarantined) AS rows_quarantined, SUM(rows_in) AS rows_checked FROM ops.run_log WHERE step LIKE 'silver:%' GROUP BY ALL"
      ]
    }
  ],
